{
  "name": "pk-payments-sdk",
  "version": "0.1.0",
  "description": "JazzCash and Easypaisa for Node.js and TypeScript: hosted checkout, mobile wallet charges, status inquiry and verified callbacks.",
  "keywords": [
    "pakistan",
    "jazzcash",
    "easypaisa",
    "payment-gateway",
    "payments",
    "checkout",
    "mobile-wallet",
    "ipn",
    "pkr"
  ],
  "license": "MIT",
  "author": "Softechies Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softechies/pk-payments-sdk.git"
  },
  "homepage": "https://github.com/softechies/pk-payments-sdk#readme",
  "bugs": {
    "url": "https://github.com/softechies/pk-payments-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
